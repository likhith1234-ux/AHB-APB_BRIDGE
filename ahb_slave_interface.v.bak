module ahb_slave_interface (
    input         Hclk,
    input         Hresetn,
    input  [31:0] Haddr,
    input  [31:0] Hwdata,
    input         Hwrite,
    input  [1:0]  Htrans,
    input         Hreadyin,
    input  [31:0] Prdata,

    output reg [31:0] Haddr1,
    output reg [31:0] Haddr2,
    output reg [31:0] Hwdata1,
    output reg        Hwritereg,
    output reg        Hwritereg1,
    output reg [2:0]  tempselx,
    output reg        valid,
    output [31:0]     Hrdata
);

/////////////////////////////////////////////////
// Address Pipeline
/////////////////////////////////////////////////

always @(posedge Hclk)
begin
    if (!Hresetn)
    begin
        Haddr1 <= 32'd0;
        Haddr2 <= 32'd0;
    end
    else
    begin
        Haddr1 <= Haddr;
        Haddr2 <= Haddr1;
    end
end

/////////////////////////////////////////////////
// Write Control Pipeline
/////////////////////////////////////////////////

always @(posedge Hclk)
begin
    if (!Hresetn)
    begin
        Hwritereg  <= 1'b0;
        Hwritereg1 <= 1'b0;
    end
    else
    begin
        Hwritereg  <= Hwrite;
        Hwritereg1 <= Hwritereg;
    end
end

/////////////////////////////////////////////////
// Write Data Pipeline
/////////////////////////////////////////////////

always @(posedge Hclk)
begin
    if (!Hresetn)
        Hwdata1 <= 32'd0;
    else
        Hwdata1 <= Hwdata;
end

/////////////////////////////////////////////////
// Peripheral Selection
/////////////////////////////////////////////////

always @(*)
begin
    tempselx = 3'b000;

    if ((Haddr >= 32'h8000_0000) &&
        (Haddr < 32'h8400_0000))
        tempselx = 3'b001;

    else if ((Haddr >= 32'h8400_0000) &&
             (Haddr < 32'h8800_0000))
        tempselx = 3'b010;

    else if ((Haddr >= 32'h8800_0000) &&
             (Haddr < 32'h8C00_0000))
        tempselx = 3'b100;
end

/////////////////////////////////////////////////
// Valid Transaction Logic
/////////////////////////////////////////////////

always @(*)
begin
    valid = 1'b0;

    if ((Haddr >= 32'h8000_0000) &&
        (Haddr < 32'h8C00_0000) &&
        Hreadyin &&
        (Htrans == 2'b10 || Htrans == 2'b11))
        valid = 1'b1;
end

/////////////////////////////////////////////////
// Read Data
/////////////////////////////////////////////////

assign Hrdata = Prdata;

endmodule
