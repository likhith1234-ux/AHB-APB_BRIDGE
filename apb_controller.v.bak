module apb_controller(
    input         hclk,
    input         hresetn,
    input         valid,
    input         hwrite,
    input         hwrite_reg,

    input  [2:0]  temp_selx,
    input  [31:0] haddr_1,
    input  [31:0] haddr_2,
    input  [31:0] hwdata_1,

    output reg        penable,
    output reg        pwrite,
    output reg        hr_readyout,
    output reg [2:0]  psel,
    output reg [31:0] paddr,
    output reg [31:0] pwdata
);

/////////////////////////////////////////////////
// State Declaration
/////////////////////////////////////////////////

parameter ST_IDLE     = 3'b000,
          ST_READ     = 3'b001,
          ST_RENABLE  = 3'b010,
          ST_WWAIT    = 3'b011,
          ST_WRITE    = 3'b100,
          ST_WENABLE  = 3'b101,
          ST_WRITEP   = 3'b110,
          ST_WENABLEP = 3'b111;

reg [2:0] ps, ns;

/////////////////////////////////////////////////
// Temporary Registers
/////////////////////////////////////////////////

reg        penable_temp;
reg        pwrite_temp;
reg        hr_readyout_temp;
reg [2:0]  psel_temp;
reg [31:0] padder_temp;
reg [31:0] pwdata_temp;

/////////////////////////////////////////////////
// Present State Logic
/////////////////////////////////////////////////

always @(posedge hclk or negedge hresetn)
begin
    if(!hresetn)
        ps <= ST_IDLE;
    else
        ps <= ns;
end

/////////////////////////////////////////////////
// Next State Logic
/////////////////////////////////////////////////

always @(*)
begin
    case(ps)

        ST_IDLE:
        begin
            if(valid && hwrite)
                ns = ST_WWAIT;
            else if(valid && !hwrite)
                ns = ST_READ;
            else
                ns = ST_IDLE;
        end

        ST_READ:
            ns = ST_RENABLE;

        ST_RENABLE:
        begin
            if(!valid)
                ns = ST_IDLE;
            else if(valid && !hwrite)
                ns = ST_READ;
            else
                ns = ST_WWAIT;
        end

        ST_WWAIT:
        begin
            if(!valid)
                ns = ST_WRITE;
            else
                ns = ST_WRITEP;
        end

        ST_WRITE:
            ns = ST_WENABLE;

        ST_WENABLE:
        begin
            if(!valid)
                ns = ST_IDLE;
            else if(valid && hwrite)
                ns = ST_WRITE;
            else
                ns = ST_READ;
        end

        ST_WRITEP:
            ns = ST_WENABLEP;

        ST_WENABLEP:
        begin
            if(!valid && hwrite_reg)
                ns = ST_WRITE;

            else if(valid && hwrite_reg)
                ns = ST_WRITEP;

            else if(!hwrite_reg)
                ns = ST_READ;

            else
                ns = ST_IDLE;
        end

        default:
            ns = ST_IDLE;

    endcase
end

/////////////////////////////////////////////////
// Temporary Output Logic
/////////////////////////////////////////////////

always @(*)
begin

    psel_temp        = 3'b000;
    penable_temp     = 1'b0;
    pwrite_temp      = 1'b0;
    hr_readyout_temp = 1'b1;
    padder_temp      = 32'd0;
    pwdata_temp      = 32'd0;

    case(ps)

        ST_IDLE:
        begin
            psel_temp        = 3'b000;
            penable_temp     = 1'b0;
            pwrite_temp      = 1'b0;
            hr_readyout_temp = 1'b1;
        end

        ST_READ:
        begin
            psel_temp        = temp_selx;
            penable_temp     = 1'b0;
            pwrite_temp      = 1'b0;
            hr_readyout_temp = 1'b0;
            padder_temp      = haddr_1;
        end

        ST_RENABLE:
        begin
            psel_temp        = temp_selx;
            penable_temp     = 1'b1;
            pwrite_temp      = 1'b0;
            hr_readyout_temp = 1'b1;
            padder_temp      = haddr_1;
        end

        ST_WWAIT:
        begin
            psel_temp        = 3'b000;
            penable_temp     = 1'b0;
            pwrite_temp      = 1'b0;
            hr_readyout_temp = 1'b0;
        end

        ST_WRITE:
        begin
            psel_temp        = temp_selx;
            penable_temp     = 1'b0;
            pwrite_temp      = 1'b1;
            hr_readyout_temp = 1'b0;
            padder_temp      = haddr_2;
            pwdata_temp      = hwdata_1;
        end

        ST_WENABLE:
        begin
            psel_temp        = temp_selx;
            penable_temp     = 1'b1;
            pwrite_temp      = 1'b1;
            hr_readyout_temp = 1'b1;
            padder_temp      = haddr_2;
            pwdata_temp      = hwdata_1;
        end

        ST_WRITEP:
        begin
            psel_temp        = temp_selx;
            penable_temp     = 1'b0;
            pwrite_temp      = 1'b1;
            hr_readyout_temp = 1'b0;
            padder_temp      = haddr_2;
            pwdata_temp      = hwdata_1;
        end

        ST_WENABLEP:
        begin
            psel_temp        = temp_selx;
            penable_temp     = 1'b1;
            pwrite_temp      = 1'b1;
            hr_readyout_temp = 1'b1;
            padder_temp      = haddr_2;
            pwdata_temp      = hwdata_1;
        end

    endcase
end

/////////////////////////////////////////////////
// Registered Outputs
/////////////////////////////////////////////////

always @(posedge hclk or negedge hresetn)
begin
    if(!hresetn)
    begin
        psel        <= 3'b000;
        penable     <= 1'b0;
        pwrite      <= 1'b0;
        hr_readyout <= 1'b1;
        paddr       <= 32'd0;
        pwdata      <= 32'd0;
    end
    else
    begin
        psel        <= psel_temp;
        penable     <= penable_temp;
        pwrite      <= pwrite_temp;
        hr_readyout <= hr_readyout_temp;
        paddr       <= padder_temp;
        pwdata      <= pwdata_temp;
    end
end

endmodule
