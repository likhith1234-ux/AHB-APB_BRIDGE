module ahb_apb_bridge_top(
    input         hclk,
    input         hresetn,
    input         hwrite,
    input         hreadyin,
    input  [1:0]  htrans,
    input  [31:0] hwdata,
    input  [31:0] haddr,
    input  [31:0] prdata,

    output        pwrite,
    output        penable,
    output        hr_readyout,
    output [2:0]  psel,
    output [31:0] paddr,
    output [31:0] pwdata,
    output [31:0] hrdata,
    output [1:0]  hresp
);

wire        valid;
wire [31:0] hwdata_1;
wire [31:0] haddr_1;
wire [31:0] haddr_2;
wire [2:0]  temp_selx;


ahb_slave_interface ahb_S(
    .Hclk(hclk),
    .Hresetn(hresetn),
    .Hwrite(hwrite),
    .Hreadyin(hreadyin),
    .Htrans(htrans),
    .Hwdata(hwdata),
    .Haddr(haddr),
    .Prdata(prdata),

    .valid(valid),
    .Haddr1(haddr_1),
    .Haddr2(haddr_2),
    .Hwdata1(hwdata_1),
    .tempselx(temp_selx),
    .Hrdata(hrdata),
    .Hwritereg(hwrite_reg),
    .Hwritereg1(hwrite_reg1)
);


apb_controller apb_C(
    .hclk(hclk),
    .hresetn(hresetn),
    .hwrite(hwrite),
    .hwrite_reg(hwrite_reg),
    .valid(valid),

   
    .haddr_1(haddr_1),
    .haddr_2(haddr_2),

    .hwdata_1(hwdata_1),
    .temp_selx(temp_selx),

    .penable(penable),
    .pwrite(pwrite),
    .hr_readyout(hr_readyout),
    .paddr(paddr),
    .pwdata(pwdata),
    .psel(psel)
);

endmodule
